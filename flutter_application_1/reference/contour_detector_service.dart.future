import 'dart:io';
import 'dart:math' as math;

import 'package:opencv_dart/opencv_dart.dart' as cv;

/// STATUS SAAT INI: file ini TIDAK dipakai oleh scanner_screen.dart —
/// dependency `opencv_dart` sengaja dikomentari di pubspec.yaml karena v1.x
/// (yang ditarget file ini) sudah end-of-life & mentok masalah compileSdk
/// Android. File ini dipertahankan sebagai referensi logika (Canny Edge +
/// approxPolyDP) untuk disambung lagi setelah migrasi ke opencv_dart v2.x —
/// lihat README bagian "Menyalakan kembali deteksi kontur OpenCV".
///
/// CATATAN PENTING: nama kelas/fungsi opencv_dart di bawah ini ditulis
/// mengikuti konvensi API publik package tersebut (lowerCamelCase,
/// mis. cv.cvtColor, cv.imread), tapi package ini berkembang cepat dan
/// method-nya bisa sedikit berbeda antar versi (lihat catatan versi 1.x vs
/// 2.x di README). Setelah `flutter pub get`, cek dokumentasi versi yang
/// ter-install (pub.dev/documentation/opencv_dart) atau contoh resminya
/// bila ada method yang tidak ditemukan compiler, lalu sesuaikan nama
/// method di file ini — logikanya (Canny -> findContours -> approxPolyDP)
/// tetap sama persis dengan Rumusan Masalah #1 di naskah.

/// Hasil deteksi kontur struk: 4 titik sudut kertas dalam koordinat piksel
/// gambar asli, sudah diurutkan (top-left, top-right, bottom-right, bottom-left).
class ReceiptContour {
  final List<cv.Point> corners;
  ReceiptContour(this.corners);
}

/// Implementasi deteksi kontur kertas struk menggunakan algoritma Canny
/// Edge Detection dan aproksimasi poligon (approxPolyDP), sesuai Rumusan
/// Masalah #1 dan BAB II.3 pada naskah skripsi.
class ContourDetectorService {
  /// Mendeteksi kontur 4 sudut struk pada satu frame/gambar.
  /// Mengembalikan null jika tidak ditemukan kontur poligon 4 sudut yang
  /// cukup besar (kemungkinan struk belum sepenuhnya masuk frame).
  ReceiptContour? detect(cv.Mat frame, {double minAreaRatio = 0.15}) {
    final gray = cv.cvtColor(frame, cv.COLOR_BGR2GRAY);
    final blurred = cv.gaussianBlur(gray, (5, 5), 0);

    // Canny Edge Detection — dua threshold (low, high) sesuai praktik umum.
    final edges = cv.canny(blurred, 75, 200);

    // Dilasi tipis agar tepi struk yang putus-putus (mis. karena pudar atau
    // kemiringan pencahayaan) tersambung kembali sebelum dicari konturnya.
    final dilated = cv.dilate(
      edges,
      cv.getStructuringElement(cv.MORPH_RECT, (3, 3)),
    );

    final contoursResult = cv.findContours(
      dilated,
      cv.RETR_LIST,
      cv.CHAIN_APPROX_SIMPLE,
    );
    final contours = contoursResult.$1;

    final frameArea = (frame.rows * frame.cols).toDouble();
    cv.VecPoint? bestQuad;
    double bestArea = 0;

    for (final contour in contours) {
      final area = cv.contourArea(contour);
      if (area < frameArea * minAreaRatio) continue;

      final peri = cv.arcLength(contour, true);
      final approx = cv.approxPolyDP(contour, 0.02 * peri, true);

      // Kertas struk diasumsikan berbentuk quadrilateral (4 sudut).
      if (approx.length == 4 && area > bestArea) {
        bestQuad = approx;
        bestArea = area;
      }
    }

    if (bestQuad == null) return null;
    return ReceiptContour(_orderCorners(bestQuad.toList()));
  }

  /// Mengurutkan 4 titik sudut: top-left, top-right, bottom-right, bottom-left.
  /// Perlu agar hasil perspective warp tidak terbalik/miring.
  List<cv.Point> _orderCorners(List<cv.Point> pts) {
    final sums = pts.map((p) => p.x + p.y).toList();
    final diffs = pts.map((p) => p.y - p.x).toList();

    final topLeft = pts[sums.indexOf(sums.reduce(math.min))];
    final bottomRight = pts[sums.indexOf(sums.reduce(math.max))];
    final topRight = pts[diffs.indexOf(diffs.reduce(math.min))];
    final bottomLeft = pts[diffs.indexOf(diffs.reduce(math.max))];

    return [topLeft, topRight, bottomRight, bottomLeft];
  }

  /// Memotong & meluruskan (perspective warp) area struk dari foto asli
  /// menjadi gambar top-down rectangular, siap dikirim ke model Donut.
  cv.Mat warpToRect(
    cv.Mat original,
    List<cv.Point> corners, {
    int outWidth = 800,
    int outHeight = 1120,
  }) {
    final src = cv.VecPoint2f.fromList(
      corners.map((p) => cv.Point2f(p.x.toDouble(), p.y.toDouble())).toList(),
    );
    final dst = cv.VecPoint2f.fromList([
      cv.Point2f(0, 0),
      cv.Point2f(outWidth.toDouble(), 0),
      cv.Point2f(outWidth.toDouble(), outHeight.toDouble()),
      cv.Point2f(0, outHeight.toDouble()),
    ]);

    final transform = cv.getPerspectiveTransform2f(src, dst);
    return cv.warpPerspective(original, transform, (outWidth, outHeight));
  }

  /// Memuat gambar dari file (mis. hasil capture kamera) sebagai cv.Mat.
  cv.Mat loadFromFile(File file) => cv.imread(file.path);
}
